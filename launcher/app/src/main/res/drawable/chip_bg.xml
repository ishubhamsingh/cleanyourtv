<?xml version="1.0" encoding="utf-8"?>
<!-- All apps sort chips: white while focused, a light pill for the order in use, plain otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#40FFFFFF" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="18dp" /></shape>
    </item>
</selector>
