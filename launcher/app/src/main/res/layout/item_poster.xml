<?xml version="1.0" encoding="utf-8"?>
<!-- Discover: one movie or show in a row under the dock, or in search. The card is sized in code to the app tiles. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/poster"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:foreground="@drawable/poster_focus"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/poster_scrim" />

        <!-- Dashboard: #1 to #5 on the Trending and Top rows. -->
        <TextView
            android:id="@+id/posterRank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/poster_rank"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/posterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:lineSpacingExtra="1dp"
            android:fontFamily="@string/font_medium"
            android:shadowColor="#99000000"
            android:shadowRadius="4" />
    </FrameLayout>

    <TextView
        android:id="@+id/posterApp"
        android:layout_width="180dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="108dp"
        android:includeFontPadding="false"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@string/font_body"
        android:alpha="0" />
</FrameLayout>
