<?xml version="1.0" encoding="utf-8"?>
<!-- The clock screensaver's media block (aurora_background with now_playing): cover, title, artist and progress under
     the date, shown only while something plays. Added to dreamContent by ClockScene, so it drifts with the clock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dreamMedia"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="22dp"
    android:layout_marginStart="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <ImageView
        android:id="@+id/dreamArt"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dreamTitle"
            style="@style/DashSmall"
            android:textColor="#F2FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/dreamArtist"
            style="@style/DashSmall"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/dreamProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progressDrawable="@drawable/np_progress" />
    </LinearLayout>
</LinearLayout>
