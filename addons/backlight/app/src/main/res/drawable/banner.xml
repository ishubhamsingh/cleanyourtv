    android:width="320dp" android:height="180dp"
    android:viewportWidth="320" android:viewportHeight="180">
    <path android:fillColor="#FF0C0E13" android:pathData="M0,0h320v180h-320z" />
    <!-- The glow: three soft clouds behind the screen. -->
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="112" android:centerY="78" android:gradientRadius="110">
                <item android:offset="0" android:color="#FF8E6CF0" />
                <item android:offset="1" android:color="#008E6CF0" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="214" android:centerY="84" android:gradientRadius="105">
                <item android:offset="0" android:color="#E634C6E0" />
                <item android:offset="1" android:color="#0034C6E0" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="160" android:centerY="140" android:gradientRadius="80">
                <item android:offset="0" android:color="#CCFFB46B" />
                <item android:offset="1" android:color="#00FFB46B" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- The TV: a dark screen with a thin bezel. -->
    <path android:fillColor="#FF05070A" android:strokeColor="#40FFFFFF" android:strokeWidth="1.5"
        android:pathData="M90,46h140a6,6 0,0 1,6 6v76a6,6 0,0 1,-6 6h-140a6,6 0,0 1,-6 -6v-76a6,6 0,0 1,6 -6z" />
